import os

// under `oboe run` the executable is a temp file, so it differs from script_file()
func main(array args) {
    var exe = os.exe_file()
    var dir = os.exe_dir()

    print(exe != null)
    print(exe.starts_with("/"))
    print(os.exists(exe))
    print(os.is_dir(dir))
    print(exe.starts_with("${dir}/"))
    print(exe == "${dir}/${exe.split("/").pop()}")
    print(exe != os.script_file())
}
